{
  "mcpServers": {
    "ast-grep": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "exec ast-grep-mcp-server --config \"$(git rev-parse --show-toplevel)/sgconfig.yml\""
      ]
    },
    "ripwire": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "exec ripwire \"$(git rev-parse --show-toplevel)\" --mcp"
      ]
    },
    "serena": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-lc",
        "exec mcp.sh -q -m serena attach --project \"$(git rev-parse --show-toplevel)\""
      ]
    }
  }
}
