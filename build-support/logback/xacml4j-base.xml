<!--
  The shared test configuration: a shutdown hook that stops the logger context (and so
  flushes the async queues) when the JVM exits, the shared appenders, and the default
  levels. Every module's logback-test.xml includes this file; the root POM puts this
  directory on every module's test class path.
  -->
<included>
	<shutdownHook/>
	<include resource="xacml4j-appenders.xml"/>
	<include resource="xacml4j-levels.xml"/>
</included>
