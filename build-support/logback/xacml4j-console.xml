<!--
  Shared console appender (change upgrade-dependencies, design D2 and D3): CONSOLE wrapped in
  ASYNC_CONSOLE, without caller data. System properties (or <property> before the include):
    xacml4j.log.console.level  lowest level shown (default WARN)
    xacml4j.log.console.target System.out (default) or System.err
    xacml4j.log.queue          async queue size (default 8192)
    xacml4j.log.neverBlock     drop events on a full queue instead of blocking (default false)
  -->
<included>
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<target>${xacml4j.log.console.target:-System.out}</target>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>${xacml4j.log.console.level:-WARN}</level>
		</filter>
		<encoder>
			<pattern>%-5level %d{HH:mm:ss.SSS} [%thread] %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
		<queueSize>${xacml4j.log.queue:-8192}</queueSize>
		<discardingThreshold>0</discardingThreshold>
		<neverBlock>${xacml4j.log.neverBlock:-false}</neverBlock>
		<includeCallerData>false</includeCallerData>
		<!-- 0: at shutdown, wait until every queued event is written (default 1 s; review RVG). -->
		<maxFlushTime>${xacml4j.log.maxFlushTime:-0}</maxFlushTime>
		<appender-ref ref="CONSOLE"/>
	</appender>
</included>
