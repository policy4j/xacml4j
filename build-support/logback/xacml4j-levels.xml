<!--
  Shared default levels for tests: root at ${xacml4j.log.level:-INFO}, the project's own
  loggers at ${xacml4j.log.xacml4j.level:-DEBUG}, both to the async console (WARN and up by
  default) and the async file. Include after xacml4j-appenders.xml; a module adds its own
  <logger> elements after the include.
  -->
<included>
	<logger name="org.xacml4j" level="${xacml4j.log.xacml4j.level:-DEBUG}"/>

	<root level="${xacml4j.log.level:-INFO}">
		<appender-ref ref="ASYNC_CONSOLE"/>
		<appender-ref ref="ASYNC_FILE"/>
	</root>
</included>
