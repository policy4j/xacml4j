<!--
  Shared file appender (change upgrade-dependencies, design D2 and D3): FILE wrapped in
  ASYNC_FILE, without caller data. System properties (or <property> before the include):
    xacml4j.log.dir            file directory (default target/logs)
    xacml4j.log.name           file name without .log (each module sets its own)
    xacml4j.log.queue          async queue size (default 8192)
    xacml4j.log.neverBlock     drop events on a full queue instead of blocking (default false)
  -->
<included>
	<appender name="FILE" class="ch.qos.logback.core.FileAppender">
		<file>${xacml4j.log.dir:-target/logs}/${xacml4j.log.name:-xacml4j}.log</file>
		<append>false</append>
		<encoder>
			<pattern>%-5level %d{yyyy-MM-dd'T'HH:mm:ss.SSS} [%thread] %logger - %msg%n</pattern>
		</encoder>
	</appender>

	<appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
		<queueSize>${xacml4j.log.queue:-8192}</queueSize>
		<discardingThreshold>0</discardingThreshold>
		<neverBlock>${xacml4j.log.neverBlock:-false}</neverBlock>
		<includeCallerData>false</includeCallerData>
		<!-- 0: at shutdown, wait until every queued event is written (default 1 s; review RVG). -->
		<maxFlushTime>${xacml4j.log.maxFlushTime:-0}</maxFlushTime>
		<appender-ref ref="FILE"/>
	</appender>
</included>
