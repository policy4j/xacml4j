<!--
  Probe configuration of LoggingConfigurationTest: the shared async settings of
  build-support/logback (queue, discarding threshold, flush time from the same property and
  default) in front of a downstream appender that takes 1 ms per event, so that a probe that
  logs 2,000 events and returns still has a backlog of about two seconds at exit.
  -->
<configuration>
	<shutdownHook/>
	<appender name="SLOW" class="org.xacml4j.logging.SlowFileAppender">
		<file>${xacml4j.log.dir}/slow.log</file>
		<delayMillis>1</delayMillis>
	</appender>
	<appender name="ASYNC_SLOW" class="ch.qos.logback.classic.AsyncAppender">
		<queueSize>${xacml4j.log.queue:-8192}</queueSize>
		<discardingThreshold>0</discardingThreshold>
		<neverBlock>${xacml4j.log.neverBlock:-false}</neverBlock>
		<includeCallerData>false</includeCallerData>
		<maxFlushTime>${xacml4j.log.maxFlushTime:-0}</maxFlushTime>
		<appender-ref ref="SLOW"/>
	</appender>
	<root level="INFO">
		<appender-ref ref="ASYNC_SLOW"/>
	</root>
</configuration>
