diff --git a/xacml-xml/src/test/java/org/xacml4j/v30/xml/BooleanAttributeLexicalTest.java b/xacml-xml/src/test/java/org/xacml4j/v30/xml/BooleanAttributeLexicalTest.java
--- /dev/null
+++ b/xacml-xml/src/test/java/org/xacml4j/v30/xml/BooleanAttributeLexicalTest.java
@@ -0,0 +1,207 @@
+package org.xacml4j.v30.xml;
+
+/*
+ * #%L
+ * Xacml4J Core Engine Implementation
+ * %%
