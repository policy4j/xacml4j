+
+	private AttributeValueType typedValue(String type, String lexical)
+	{
+		AttributeValueType value = new AttributeValueType();
+		value.setDataType("http://www.w3.org/2001/XMLSchema#" + type);
+		value.getContent().add(lexical);
+		return value;
